      <trkpt lat="51.47720" lon="-0.00100"/>
      <trkpt lat="51.47750" lon="-0.00050"/>
      <trkpt lat="51.47780" lon="0.00000"/>
      <trkpt lat="51.47810" lon="0.00050"/>
    </trkseg>
  </trk>
</gpx>
